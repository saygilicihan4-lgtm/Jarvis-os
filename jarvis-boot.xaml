<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JARVIS" WindowStyle="None" ResizeMode="NoResize"
        WindowState="Maximized" Background="#050B14" Foreground="#EAF6FF"
        FontFamily="Segoe UI" ShowInTaskbar="True">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#10263A"/>
      <Setter Property="Foreground" Value="#EAF6FF"/>
      <Setter Property="BorderBrush" Value="#37627C"/>
      <Setter Property="Padding" Value="20,10"/>
      <Setter Property="Margin" Value="6"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.Background>
      <RadialGradientBrush>
        <GradientStop Color="#112C47" Offset="0"/>
        <GradientStop Color="#050B14" Offset="1"/>
      </RadialGradientBrush>
    </Grid.Background>
    <Viewbox Stretch="Uniform" Margin="30">
      <Grid Width="860" Height="580">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="780">
          <TextBlock Text="J A R V I S" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="İyi ki geldiniz, Cihan Bey." FontSize="18" Foreground="#A6BECE" Margin="0,8,0,0" HorizontalAlignment="Center"/>
          <Grid Width="180" Height="180" Margin="0,25,0,24">
            <Ellipse Stroke="#254B66" StrokeThickness="1"/>
            <Ellipse Margin="12" Stroke="#64DDFA" StrokeThickness="2" StrokeDashArray="12 5 2 5" RenderTransformOrigin="0.5,0.5">
              <Ellipse.RenderTransform><RotateTransform x:Name="CoreRotation"/></Ellipse.RenderTransform>
              <Ellipse.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:18" RepeatBehavior="Forever"/>
              </Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
            </Ellipse>
            <Ellipse Margin="34" Stroke="#3381A8" StrokeThickness="1"/>
            <Ellipse Margin="61" Fill="#62DDF9" Opacity="0.8"/>
          </Grid>
          <TextBlock x:Name="StageText" Text="Başlatılıyor" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock x:Name="DetailText" Text="Bilgisayar bağlantısı kontrol ediliyor." FontSize="16" Foreground="#A6BECE" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
          <TextBlock x:Name="StatusText" Text="BİLGİSAYAR · BEKLENİYOR" FontSize="13" Foreground="#70D8F0" Margin="0,18,0,0" TextAlignment="Center"/>
          <ProgressBar x:Name="BootProgress" Width="430" Height="4" IsIndeterminate="True" Foreground="#62DDF9" Background="#152638" BorderThickness="0" Margin="0,20,0,16"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="RetryButton" Content="Yeniden dene" Visibility="Collapsed"/>
            <Button x:Name="LogButton" Content="Günlüğü aç" Visibility="Collapsed"/>
            <Button x:Name="CloseButton" Content="Masaüstüne dön"/>
          </StackPanel>
          <TextBlock Text="ESC · Masaüstüne dön" FontSize="12" Foreground="#748DA1" Margin="0,12,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Viewbox>
  </Grid>
</Window>
